<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Mover · by Dawn"
        Width="880" Height="800" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F7F7F8"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Dawn light theme tokens (ChatGPT / Apple style with dawn accents) -->
        <SolidColorBrush x:Key="BgBrush" Color="#F7F7F8"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#EFEFF1"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA1FF"/>
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B78E8"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#34C759"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FF9500"/>
        <SolidColorBrush x:Key="DisabledBrush" Color="#D1D1D6"/>
        <LinearGradientBrush x:Key="DawnGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB27A" Offset="0"/>
            <GradientStop Color="#4F8CFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource DawnGradientBrush}" CornerRadius="10" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DisabledBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="18,16,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Codex Mover" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Border Background="{StaticResource DawnGradientBrush}" CornerRadius="10" Padding="9,2" Margin="10,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="by Dawn" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="图形向导 v1.2.0 · 把 Codex 数据和工作区安全迁移到其他磁盘" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Border x:Name="StatusChip" Background="#1A34C759" CornerRadius="10" Padding="12,5">
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18,0,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 1. Sources -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardTitleStyle}" Text="1 · 选择要迁移的目录" Margin="0,0,0,0"/>
                                <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="刷新大小" Padding="12,5" FontSize="12" VerticalAlignment="Top"/>
                            </Grid>
                            <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,10,0,0" Padding="8">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SrcList"/>
                                </ScrollViewer>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustom" Style="{StaticResource InputBoxStyle}" ToolTip="输入要迁移的自定义目录路径"/>
                                <Button x:Name="BtnAdd" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="添加自定义目录" Margin="8,0,0,0" Padding="12,6"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="勾选要迁移的目录；已迁移的会显示“联接”，可取消勾选。" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Target -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="2 · 选择目标位置"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="目标盘" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="DriveCombo" Grid.Column="1" Margin="0,0,12,0" Padding="8,6" ItemContainerStyle="{StaticResource ComboItemStyle}"/>
                                <TextBlock Grid.Column="2" Text="文件夹" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="FolderBox" Grid.Column="3" Style="{StaticResource InputBoxStyle}" Text="CodexData"/>
                            </Grid>
                            <TextBlock x:Name="LblRoot" Style="{StaticResource HintTextStyle}" Text="迁移目标: (请选择盘符和文件夹)" Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Options -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="3 · 选项"/>
                            <WrapPanel>
                                <CheckBox x:Name="CbBackup" Style="{StaticResource OptionCheckBoxStyle}" Content="保留完整备份（推荐）" IsChecked="True" Margin="0,4,24,4"/>
                                <CheckBox x:Name="CbDryRun" Style="{StaticResource OptionCheckBoxStyle}" Content="演练模式（不修改任何东西）" Margin="0,4,24,4"/>
                                <CheckBox x:Name="CbAutoClose" Style="{StaticResource OptionCheckBoxStyle}" Content="自动关闭正在运行的 Codex"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}" Text="提示：演练模式只预览计划、不修改任何东西，也不需要先关闭 Codex。" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <Button x:Name="BtnGo" Style="{StaticResource PrimaryButtonStyle}" Content="开始迁移" Height="46"/>
                <Button x:Name="BtnRestore" Style="{StaticResource SecondaryButtonStyle}" Content="回滚 / 恢复" Margin="0,10,0,0" Height="38"/>
                <Button x:Name="BtnExit" Style="{StaticResource SecondaryButtonStyle}" Content="退出" Margin="0,10,0,0" Height="38"/>
            </StackPanel>
        </Grid>

        <!-- Log -->
        <Grid Grid.Row="2" Margin="18,0,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <ProgressBar x:Name="ProgressBar" Grid.Column="1" Width="170" Height="6" IsIndeterminate="True" Visibility="Collapsed" Background="#E9E9EC" Foreground="{StaticResource DawnGradientBrush}" BorderThickness="0"/>
            </Grid>
            <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="{StaticResource InputBgBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                     BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8"/>
        </Grid>
    </Grid>
</Window>
